<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ReportFormURL</key>
	<string>$(APP_REPORT_FORM_URL)</string>
	<key>ContactFormURL</key>
	<string>$(APP_CONTACT_FORM_URL)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(APP_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<!-- COPY BEGIN dc8580d4 [NEEDS HUMAN REVIEW] -->
	<key>NSCameraUsageDescription</key>
	<string>The camera reads the QR code on an invite somebody shows you, and the app keeps nothing else it sees.</string>
	<!-- COPY END dc8580d4 -->
	<!-- COPY BEGIN 9662b091 [NEEDS HUMAN REVIEW] -->
	<key>NSFocusStatusUsageDescription</key>
	<string>Tells the people you write to that you have notifications silenced, only if you turn that on under Privacy &amp; Safety.</string>
	<!-- COPY END 9662b091 -->
	<!-- COPY BEGIN b6501cb1 [NEEDS HUMAN REVIEW] -->
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID opens the app when you have locked it, instead of typing your code.</string>
	<!-- COPY END b6501cb1 -->
	<!-- COPY BEGIN 18088558 [NEEDS HUMAN REVIEW] -->
	<key>NSNearbyInteractionUsageDescription</key>
	<string>Measures how close the other phone is, so codes are swapped only with the phone you hold yours against.</string>
	<!-- COPY END 18088558 -->
	<!-- COPY BEGIN 40e4a902 [NEEDS HUMAN REVIEW] -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Finds the phone you hold yours against, so the two can swap codes directly without going through iCloud.</string>
	<!-- COPY END 40e4a902 -->
	<key>NSBonjourServices</key>
	<array>
		<string>_tapswap._tcp</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
