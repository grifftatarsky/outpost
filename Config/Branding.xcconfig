// APP #################################################################
APP_DISPLAY_NAME = Outpost
APP_URL_SCHEME = outpost
APP_REPORT_FORM_URL = https:$(SLASH)$(SLASH)outpostmessaging.com/report
APP_BUNDLE_ID_PREFIX = com.microgpt
APP_ICLOUD_CONTAINER = iCloud.$(APP_BUNDLE_ID_PREFIX).outpost
// APS #################################################################
APS_ENVIRONMENT = development
APS_ENVIRONMENT[config=Release] = production
// INFOPLIST ###########################################################
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_CFBundleName = $(APP_DISPLAY_NAME)
// SWIFT ###############################################################
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
// TODO: IS THIS ACTUALLY NEEDED #######################################
SLASH = /
//######################################################################
